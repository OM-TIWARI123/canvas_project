{
  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "target": "ES2022",
    "skipLibCheck": true,
    "strictNullChecks": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@repo/ui/*": ["../../packages/ui/src/*"],
      "@repo/utils/*": ["../../packages/utils/src/*"],
      "@services/database/*": ["../../services/database/src/*"],
      "@services/betterauth": ["../../services/betterauth/src"]
    }
  }
}
